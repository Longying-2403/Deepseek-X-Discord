# 复制成 .env 再填。这个文件里的东西不要发给任何人，也不要提交到 git。

# Discord 开发者后台 → 你的应用 → Bot → Reset Token
DISCORD_TOKEN=

# platform.deepseek.com → API keys（记得先充一点余额）
DEEPSEEK_API_KEY=

# 你自己的 Discord 用户 ID（设置 → 高级 → 打开开发者模式，然后右键自己的头像 → 复制用户 ID）
OWNER_ID=

# 想在 Discord 里用主人命令 /dsowner（改预算、联网搜索等）就要填：放这个命令的服务器 ID（右键服务器图标 → 复制服务器 ID）
# 平时聊天的服务器就行（朋友的也可以）：/dsowner 只出现在这个服务器，和 /ds 一样只有有「管理服务器」权限的人看得到，也只有 OWNER_ID 本人能用。不填就没有 /dsowner
CONTROL_GUILD_ID=

# 可选：连 Discord 需要走代理时填，例如 http://127.0.0.1:7890
DISCORD_PROXY=

# 可选，但推荐填：打开群友发的网页链接、上网找图都靠它；DeepSeek 自带的搜索用不了时也改用它
# （tavily.com 注册，每月免费 1000 次额度。不填也能读 X 的推文，表情包库也照常能用）
TAVILY_API_KEY=

# 可选：桌面操作（你私信叫它开关电脑上的程序、打开网址）。填一串随机字符（至少 16 个），
# 电脑上桌面小程序的 agent.toml 里填一样的。不填就不开。生成一串：python -c "import secrets; print(secrets.token_urlsafe(32))"
DESKTOP_TOKEN=
