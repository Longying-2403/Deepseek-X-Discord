# Copy this to .env and fill it in. Never share what's in this file with anyone, and don't commit it to git.

# Discord Developer Portal → your application → Bot → Reset Token
DISCORD_TOKEN=

# platform.deepseek.com → API keys (remember to top up a little balance first)
DEEPSEEK_API_KEY=

# Your own Discord user ID (Settings → Advanced → turn on Developer Mode, then right-click your avatar → Copy User ID)
OWNER_ID=

# Needed for the owner command /dsowner in Discord (budget, web search, etc.): the ID of the server to put it in (right-click the server icon → Copy Server ID)
# A server you chat in anyway is fine (a friend's works too): /dsowner only shows up in that server; like /ds, only people with the "Manage Server" permission can see it, and only OWNER_ID can use it. Leave it empty for no /dsowner
CONTROL_GUILD_ID=

# Optional: set this if you need a proxy to reach Discord, e.g. http://127.0.0.1:7890
DISCORD_PROXY=

# Optional: web search uses DeepSeek's built-in search by default; when that doesn't work it switches to Tavily (sign up at tavily.com, 1,000 free searches a month)
TAVILY_API_KEY=
